<Window x:Class="ZTHubApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZTHubApp.Views"
        xmlns:models="clr-namespace:ZTHubApp.Models"
        mc:Ignorable="d"
        Title="ZT Hub alpha v1.1.3" Height="800" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource PrimaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <DockPanel Grid.Row="0" Margin="10">
            <Button DockPanel.Dock="Left" Content="⚙️" Width="30" ToolTip="Paramètres" Click="SettingsButton_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Rechercher" Width="100" Click="SearchButton_Click"/>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <RadioButton Content="Animes" GroupName="Category" Tag="mangas" 
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=mangas}"/>
             
                    <RadioButton Content="Films" GroupName="Category" Tag="films" Margin="5,0,0,0"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=films}"/>
             
                    <RadioButton Content="Séries" GroupName="Category" Tag="series" Margin="5,0,0,0"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=series}"/>
             
                    <RadioButton Content="Jeux" GroupName="Category" Tag="jeux" Margin="5,0,0,0"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=jeux}"/>
                </StackPanel>
            </StackPanel>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" Margin="5,0"/>
        </DockPanel>

        <!-- Pagination -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,5" HorizontalAlignment="Left">
            <Button Content="Précédent" Margin="5" IsEnabled="{Binding CanGoPrevious}" Click="PrevButton_Click"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/>
            <Button Content="Suivant" Margin="5" IsEnabled="{Binding CanGoNext}" Click="NextButton_Click"/>
        </StackPanel>

        <!-- Contenu principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des résultats -->
            <ListBox Grid.Column="0" ItemsSource="{Binding SearchResults}" SelectionChanged="ResultsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SearchResult}">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Image Source="{Binding Image}" Width="60" Height="90" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#2d2d2d"/>

            <!-- Panneau des liens -->
            <DockPanel Grid.Column="2" Margin="10">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Hébergeurs:"/>
                    <ComboBox x:Name="HosterComboBox" ItemsSource="{Binding Hosters}" SelectionChanged="HosterComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Boutons de sélection -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                        <Button Content="Tout sélectionner" Width="110" Click="SelectAllButton_Click"/>
                        <Button Content="Tout désélectionner" Width="125" Margin="5,0,0,0" Click="DeselectAllButton_Click"/>
                    </StackPanel>

                    <!-- Boutons de téléchargement -->
                    <Button Content="Télécharger la sélection" Margin="0,5,0,5" Click="DownloadButton_Click"/>
                    <Button Content="Annuler le téléchargement" Margin="0,0,0,5" Click="CancelDownload_Click"/>
                    <Button Content="Annuler toute la file" Margin="0,0,0,5" Click="CancelQueue_Click"
                            Visibility="{Binding IsQueueActive, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Statut de la file -->
                    <TextBlock Text="{Binding QueueStatus}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#4A9EFF"/>
                </StackPanel>
                <ListBox x:Name="EpisodeListBox" ItemsSource="{Binding DownloadLinks}"
                         SelectionMode="Extended" Margin="0,10,0,0"/>
            </DockPanel>
        </Grid>

        <!-- File d'attente de téléchargement -->
        <Expander Grid.Row="3" Header="File d'attente de téléchargement"
                  IsExpanded="True"
                  Visibility="{Binding IsQueueActive, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="10,0,10,0"
                  MaxHeight="200">
            <ListBox ItemsSource="{Binding DownloadQueue}"
                     Background="{StaticResource SecondaryBackground}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Grid.Column="1" Margin="5,0,0,0"
                                       Foreground="{Binding StatusColor}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <!-- Barre de statut -->
        <StatusBar Grid.Row="4" Background="{StaticResource ControlBackground}">
            <TextBlock Text="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>