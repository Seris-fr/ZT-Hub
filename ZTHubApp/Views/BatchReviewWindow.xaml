<Window x:Class="ZTHubApp.Views.BatchReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification des résultats — Choisissez le bon film"
        Height="700"
        Width="950"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3d3d3d"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d3d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ff6b6b"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText"
                       FontSize="16" FontWeight="Bold"
                       Text="Vérification des résultats"/>
            <TextBlock x:Name="SubHeaderText"
                       FontSize="11" Foreground="#888"
                       Margin="0,3,0,0"
                       Text="Vérifiez le titre et l'image de chaque film. Utilisez la liste déroulante pour choisir le bon résultat. Cochez 'Ignorer' pour exclure un film."/>
        </StackPanel>

        <!-- Liste des films -->
        <Border Grid.Row="1" BorderBrush="#3d3d3d" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ReviewItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2d2d2d" BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Skip}" Value="True">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                                <Setter Property="Background" Value="#1a0000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Image -->
                                    <Border Grid.Column="0"
                                            Background="#2a2a2a"
                                            Width="80" Height="115"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Top">
                                        <Grid>
                                            <!-- Placeholder si pas d'image -->
                                            <TextBlock Text="🎬"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#444"/>
                                            <!-- Image chargée -->
                                            <Image Source="{Binding SelectedResult.Image}"
                                                   Stretch="UniformToFill"
                                                   Width="80" Height="115"/>
                                        </Grid>
                                    </Border>

                                    <!-- Infos -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">

                                        <!-- Film recherché -->
                                        <TextBlock Text="Film recherché :"
                                                   FontSize="10" Foreground="#666"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="{Binding SearchedName}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"/>

                                        <!-- Titre exact API -->
                                        <TextBlock Text="Résultat API (titre exact) :"
                                                   FontSize="10" Foreground="#666"
                                                   Margin="0,0,0,2"/>

                                        <!-- Cas: aucun résultat -->
                                        <TextBlock Text="⚠ Aucun résultat trouvé"
                                                   FontSize="12" Foreground="#ff6b6b"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ComboBox avec tous les résultats -->
                                        <ComboBox ItemsSource="{Binding AllResults}"
                                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                                  DisplayMemberPath="Title"
                                                  IsEnabled="{Binding HasResults}"
                                                  Margin="0,2,0,0"
                                                  MaxDropDownHeight="250">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <!-- Ignorer ce film -->
                                        <CheckBox Content="Ignorer ce film"
                                                  IsChecked="{Binding Skip, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status images -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   FontSize="11" Foreground="#4A9EFF"
                   Margin="0,8,0,5"
                   Text="Chargement des images..."/>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton"
                    Content="✓ Confirmer et télécharger"
                    Width="190"
                    Click="Confirm_Click"
                    IsDefault="True"
                    Background="#1a4a1a"
                    BorderBrush="#2d6b2d"/>
            <Button Content="Annuler"
                    Width="100"
                    Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
